# MediMind Backend Microservices Environment Template
# Copy to .env for local development. In Vercel Project Settings, configure all values as encrypted env vars.

# Runtime Environment
NODE_ENV=development
STRICT_REMOTE_DB=false

# MongoDB Atlas Connection (shared cluster, isolated logical DB per service)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_TIMEOUT_MS=10000

# Logical Database Names (Must preserve existing Atlas DB names)
AUTH_DB_NAME=medimind_auth
FAMILY_DB_NAME=medimind_family
HOSPITAL_DB_NAME=medimind_hospital
DOCTOR_DB_NAME=medimind_doctor
APPOINTMENT_DB_NAME=medimind_appointment
RECORD_DB_NAME=medimind_records
KNOWLEDGE_DB_NAME=medimind_knowledge

# Shared JWT & Internal Service Auth Secrets (MUST match across gateway, domain services, and AI service)
JWT_SECRET=<generate-a-strong-random-32+-char-secret>
JWT_EXPIRES_IN=24h
INTERNAL_SERVICE_SECRET=<generate-a-strong-random-internal-secret>
INTERNAL_SERVICE_KEY=<same-as-INTERNAL_SERVICE_SECRET-or-separate-key>

# CORS Allowlist (Comma-separated browser origins, e.g. https://medimind.vercel.app)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Deployed Python AI Prediction Service URL on Vercel (REQUIRED in production)
AI_SERVICE_URL=http://127.0.0.1:5007

# Vercel Blob Storage Read-Write Token (Required in production for >4.5 MB radiograph direct uploads)
BLOB_READ_WRITE_TOKEN=

# Optional Service URL Overrides (On Vercel backend monolith Project 2, internal routes resolve via /_internal/<service>)
AUTH_SERVICE_URL=
FAMILY_SERVICE_URL=
HOSPITAL_SERVICE_URL=
DOCTOR_SERVICE_URL=
APPOINTMENT_SERVICE_URL=
RECORD_SERVICE_URL=
KNOWLEDGE_SERVICE_URL=

# Optional Local Dev Infrastructure (Disabled automatically in production and on Vercel)
EUREKA_ENABLED=false
EUREKA_SERVER_URL=
KAFKA_ENABLED=false
KAFKA_BROKERS=

# Local Development Port Allocations (Ignored by Vercel Serverless Functions)
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
FAMILY_SERVICE_PORT=5002
HOSPITAL_SERVICE_PORT=5003
DOCTOR_SERVICE_PORT=5004
APPOINTMENT_SERVICE_PORT=5005
RECORD_SERVICE_PORT=5006
KNOWLEDGE_SERVICE_PORT=5008
