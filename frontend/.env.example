# MediMind Frontend (Vite + React) Environment Variables
# Leave empty in local development to use Vite's /api dev proxy (localhost:5000).
# Set to your deployed Backend API Gateway Vercel URL in production (no trailing slash).
VITE_API_BASE_URL=

# Optional: Set directly to your deployed Python AI Prediction Service Vercel URL
# to send AI prediction requests directly to the FastAPI deployment; leave blank
# to proxy through VITE_API_BASE_URL (/api/ai/*).
VITE_AI_SERVICE_URL=
# Optional: Set to 'private' only if your Vercel Blob store uses Private access (defaults to 'public').
VITE_BLOB_ACCESS=public
