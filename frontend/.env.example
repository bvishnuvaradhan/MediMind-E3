# MediMind Frontend (Vite + React) Environment Variables
# Leave empty in local development to use Vite's /api dev proxy (localhost:5000).
# Set to your deployed Backend API Gateway Vercel URL in production (no trailing slash).
VITE_API_BASE_URL=

# Optional: Set directly to your hosted Python AI Prediction Service URL if
# uploading large (>4.5 MB) radiographs directly without hitting Vercel payload caps.
VITE_AI_SERVICE_URL=
