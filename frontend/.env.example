# MediMind Frontend (Vite + React) Environment Variables
# Leave empty in both local dev (Vite proxies /api and /ai) and unified Vercel production (medimind.vercel.app).
VITE_API_BASE_URL=

# Optional: Leave empty to route AI calls via Node API Gateway (/api/ai/*),
# or set to '/ai' to hit the unified FastAPI Vercel Service route directly.
VITE_AI_SERVICE_URL=

# Vercel Blob direct upload visibility ('private' recommended for clinical radiographs; set 'public' only for public stores).
VITE_BLOB_ACCESS=private
