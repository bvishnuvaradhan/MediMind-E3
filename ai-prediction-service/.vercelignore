# Exclude local secrets, caches, datasets, tests, Docker configs, and non-production research artifacts from Vercel uploads
.env
.env.*
!.env.example
.git
.gitignore
.pytest_cache
__pycache__/
*.pyc
*.pyo
Dockerfile
.dockerignore
render.yaml
requirements-dev.txt
README.md
test-dataset/
tests/
scripts/
artifacts/experiments/
artifacts/fracture_v2/
artifacts/diabetes/logistic_regression.joblib
artifacts/diabetes/mlp.joblib
artifacts/diabetes/random_forest.joblib
artifacts/diabetes/training_report.json
artifacts/fracture/baseline_model.pt
artifacts/fracture/mura_pretrained_backbone.pt
artifacts/fracture/mura_pretrained_model.pt
