# MediMind AI Prediction Service Environment Template (Vercel Large Functions / Local Dev)
APP_ENV=development
PORT=5007

# Vercel Large Functions (Required in Vercel Project Settings on Pro/Enterprise for PyTorch >500 MB bundle)
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Optional Vercel Blob Storage (Needed if using Private Blob store for radiographs >4.5 MB)
BLOB_READ_WRITE_TOKEN=
ALLOWED_BLOB_HOSTS=.blob.vercel-storage.com

# MongoDB Atlas Connection (never falls back to in-memory store when APP_ENV=production or STRICT_REMOTE_DB=true)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=medimind_ai
STRICT_REMOTE_DB=false

# Shared Auth Secrets (MUST match Node.js API Gateway & Auth Service)
JWT_SECRET=<same-secret-as-backend-JWT_SECRET>
JWT_ALGORITHM=HS256
INTERNAL_SERVICE_KEY=<same-secret-as-backend-INTERNAL_SERVICE_KEY>

# CORS Allowlist (Include Frontend Vercel origin if direct large radiograph uploads are enabled)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5000

# Eureka Service Discovery (Disabled in production unless explicitly enabled)
DISABLE_EUREKA=true
EUREKA_ENABLED=false
EUREKA_SERVER_URL=

# Optional Groq LLM Clinical Explanation Enrichment
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
